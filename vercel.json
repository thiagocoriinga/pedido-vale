{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/cadastro",
      "destination": "/cadastro.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:store",
      "destination": "/admin.html?store=:store"
    },
    {
      "source": "/:store",
      "destination": "/index-sj.html?store=:store"
    }
  ]
}
